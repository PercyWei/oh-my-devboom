# oh-my-devboom：通过 bootstrap.sh --modules dotfiles 部署。
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
_devboom_zsh_dir="$XDG_CONFIG_HOME/oh-my-devboom/zsh"

# 即时提示在其余初始化之前加载。
if [[ -r "$_devboom_zsh_dir/powerlevel10k-instant.zsh" ]]; then
    source "$_devboom_zsh_dir/powerlevel10k-instant.zsh"
fi

typeset -U path fpath
path=("$HOME/.local/bin" $path)
export EDITOR="${EDITOR:-vim}"
export VISUAL="${VISUAL:-$EDITOR}"

mkdir -p "$XDG_DATA_HOME/oh-my-devboom" "$XDG_CACHE_HOME/oh-my-devboom"
HISTFILE="$XDG_DATA_HOME/oh-my-devboom/zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt AUTO_CD EXTENDED_HISTORY HIST_IGNORE_DUPS HIST_REDUCE_BLANKS SHARE_HISTORY
bindkey -e

alias ll='ls -lh'
alias la='ls -lah'
PROMPT='%n@%m:%~%# '

for _devboom_module in homebrew clash eza bat fd zellij huggingface-hub; do
    if [[ -r "$_devboom_zsh_dir/$_devboom_module.zsh" ]]; then
        source "$_devboom_zsh_dir/$_devboom_module.zsh"
    fi
done

# Antidote 在补全路径准备好后调用此函数；保留钩子供原生重新加载使用。
typeset -g _devboom_shell_initialized=0
_devboom_init_completion() {
    local module _devboom_zsh_dir="$XDG_CONFIG_HOME/oh-my-devboom/zsh"
    # 保留 use-omz 的包装器，由它重放 Git 插件排队的补全定义。
    (( $+functions[compinit] )) || autoload -Uz compinit
    compinit -i -d "$XDG_CACHE_HOME/oh-my-devboom/zcompdump"
    zstyle ':completion:*' menu select
    for module in fzf zoxide; do
        if [[ -r "$_devboom_zsh_dir/$module.zsh" ]]; then
            source "$_devboom_zsh_dir/$module.zsh"
        fi
    done
    _devboom_shell_initialized=1
}

if [[ -r "$_devboom_zsh_dir/antidote.zsh" ]]; then
    source "$_devboom_zsh_dir/antidote.zsh"
fi
# 未安装插件或移除补全插件时，仍初始化基础补全和工具。
(( _devboom_shell_initialized )) || _devboom_init_completion
unset _devboom_shell_initialized

if [[ -r "$_devboom_zsh_dir/powerlevel10k.zsh" ]]; then
    source "$_devboom_zsh_dir/powerlevel10k.zsh"
fi
unset _devboom_zsh_dir _devboom_module
